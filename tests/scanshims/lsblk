#!/bin/sh
# test shim: partitions and fields from $SHIM_DISKS
# (lines: dev parttype partuuid fstype mountdir [disk partnum [uuid [label]]], "-" = none)
case "$1" in
  -prno) awk '{ print $1, "part" }' "$SHIM_DISKS" ;;
  -dno)
    # without a udev database lsblk leaves these columns blank
    case $2 in PARTTYPE|PARTUUID|FSTYPE|UUID|LABEL) [ "${SHIM_NO_UDEV:-0}" = 1 ] && { echo; exit 0; } ;; esac
    awk -v d="$3" -v f="$2" 'function v(x) { return x == "-" ? "" : x }
      $1 == d { if (f == "PARTTYPE") print $2; if (f == "PARTUUID") print $3; if (f == "FSTYPE") print $4; if (f == "PKNAME") print v($6); if (f == "UUID") print v($8); if (f == "LABEL") print v($9) }' "$SHIM_DISKS" ;;
esac
